#!/bin/bash
# One-line control channel from the Mac (vsock 9100). Fixed commands only; nothing the Mac sends reaches a shell
# (the one argument, update-headsup's, must match a fixed pattern).
#   poweroff | ping
#   update-check  would Automatic install the channel's release now? (wam updates --apply-if-auto --check; JSON,
#                 `due: true` when it would). Only ever true on Automatic: Ask me never updates by itself.
#   update-auto   install it, under the same rules (wam updates --apply-if-auto); sent only after the disk copy
#   update-now    install the channel's release now (wam updates --apply): the owner's confirmed Update now
#   update-status the App Manager's update status (installing, failed, installed, ...), read-only
#   update-inbox  what the owner said from any device: {"request": Update now, "postponed": Not tonight}
#   update-request-clear | update-postpone-clear   the Mac took it
#   update-headsup <epoch> <version>   Automatic installs <version> at <epoch>; every device shows it with Not tonight
#   update-headsup-clear
#   update-log    the installer's log, kept on the Mac before a failed update's disk is replaced by the copy
# Updates run as the owner (wizard), like the App Manager's own timer did; /etc/wizard/updates-by-host keeps that
# timer off on a Mac (Host/OSUpdates.swift copies the disk first).
read -r cmd arg1 arg2 rest || exit 0
W=/home/wizard/.wizard-os
owner_wam() {
  local out
  out=$(sudo -iu wizard env XDG_RUNTIME_DIR=/run/user/1000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
    wam updates "$@" </dev/null 2>/dev/null)   # stdin is the vsock: a detached installer must not hold it open
  if [ -n "$out" ]; then printf '%s\n' "$out"; else echo '{"error": "the App Manager did not answer"}'; fi
}
json_or_null() { if [ -s "$1" ]; then cat "$1"; else echo null; fi; }
case "$cmd" in
  poweroff) echo ok; systemctl poweroff ;;
  ping) echo pong ;;
  update-check) owner_wam --apply-if-auto --check ;;
  update-auto) owner_wam --apply-if-auto ;;
  update-now) owner_wam --apply ;;
  update-status) owner_wam ;;
  update-inbox)
    printf '{"request": %s, "postponed": %s}\n' "$(json_or_null $W/host-update-request.json)" \
      "$(json_or_null $W/host-update-postpone.json)" ;;
  update-request-clear) rm -f $W/host-update-request.json; echo '{}' ;;
  update-postpone-clear) rm -f $W/host-update-postpone.json; echo '{}' ;;
  update-headsup)
    if [[ "$arg1" =~ ^[0-9]{10}$ && "$arg2" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && -z "$rest" ]]; then
      printf '{"target": "%s", "at": %s}\n' "$arg2" "$arg1" > $W/.host-update-headsup.json.tmp
      chown wizard:wizard $W/.host-update-headsup.json.tmp
      mv $W/.host-update-headsup.json.tmp $W/host-update-headsup.json; echo '{}'
    else echo '{"error": "update-headsup <epoch> <version>"}'; fi ;;
  update-headsup-clear) rm -f $W/host-update-headsup.json; echo '{}' ;;
  update-log) tail -n 400 $W/install.log 2>/dev/null ;;
  *) echo unknown ;;
esac
