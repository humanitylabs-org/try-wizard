#!/bin/bash
# Per-box state for the onboarding server. Idempotent; runs before it on every boot.
set -euo pipefail
install -d -o wizard -g wizard -m 0750 /var/lib/wizard
chown wizard:wizard /var/lib/wizard
# The image ships without a machine id (and without Tailscale's node key); systemd makes a fresh one.
[ -s /etc/machine-id ] || systemd-machine-id-setup >/dev/null 2>&1 || true
