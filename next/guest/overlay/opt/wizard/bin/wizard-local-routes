#!/usr/bin/env python3
"""Give the Mac window the same paths a phone gets through Tailscale Serve.

On a Linux box the owner reaches Wizard at https://<box>.<tailnet>.ts.net:<shell port>/. Tailscale Serve sends
`/` to the Wizard UX shell and a handful of paths elsewhere (the App Manager's Store and Updates listener,
Files, Notifications, the AI connection apps, the Troubleshooter). The App Manager keeps that table current
whenever an app is installed or updated.

The Mac window reaches the same box through vsock at 127.0.0.1:48023 (local-proxy.conf). This script copies
Serve's table for the shell port into nginx locations, so the Mac never needs its own list of routes and an
update that adds a route reaches the Mac with no Mac change. It also writes which tailnet login is the owner:
the local window is the owner (only the Mac's own loopback reaches this listener), and the App Manager and the
apps recognise the owner by that login, exactly as behind Serve.

Writes /run/wizard-local-proxy/routes.conf and owner.conf; prints "changed" when either changed (the caller
reloads nginx). With no Tailscale login yet, owner.conf names no owner and only `/` is routed.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit

OUT = Path(os.environ.get("WIZARD_LOCAL_ROUTES_DIR", "/run/wizard-local-proxy"))
SHELL_PORT_CMD = ["/opt/wizard/bin/wizard-shell-port"]
SAFE_PATH = re.compile(r"^/[A-Za-z0-9._~/-]*$")


def tailscale_json(*args: str) -> dict:
    try:
        out = subprocess.run(["tailscale", *args, "--json"], capture_output=True, text=True, timeout=10)
        return json.loads(out.stdout) if out.returncode == 0 and out.stdout.strip() else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}


def shell_port() -> int:
    try:
        return int(subprocess.run(SHELL_PORT_CMD, capture_output=True, text=True, timeout=5).stdout.strip())
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 8796


def owner_login(status: dict) -> str:
    self_user = str((status.get("Self") or {}).get("UserID", ""))
    login = ((status.get("User") or {}).get(self_user) or {}).get("LoginName", "")
    return login if re.fullmatch(r"[^\s\"';{}\\]{1,320}", login or "") else ""


def served_origin(serve: dict, port: int) -> str:
    """https://<box>.<tailnet>.ts.net:<port>: the origin the phone uses for the shell, or '' without Serve."""
    for hostport in (serve.get("Web") or {}):
        if hostport.endswith(f":{port}") and re.fullmatch(r"[a-z0-9.-]+\.ts\.net:\d+", hostport):
            return f"https://{hostport}"
    return ""


def handlers(serve: dict, port: int) -> list[tuple[str, str]]:
    """(mount, target) pairs Serve uses for https://<host>:<port>, longest mount first, `/` excluded."""
    rows = []
    for hostport, web in (serve.get("Web") or {}).items():
        if not hostport.endswith(f":{port}"):
            continue
        for mount, h in (web.get("Handlers") or {}).items():
            target = (h or {}).get("Proxy", "")
            if mount == "/" or not SAFE_PATH.match(mount):
                continue
            u = urlsplit(target)
            if u.scheme != "http" or u.hostname not in ("127.0.0.1", "localhost") or not u.port:
                continue   # only box-local services; never forward the owner's identity off the box
            if u.path and not SAFE_PATH.match(u.path):
                continue
            rows.append((mount, f"http://127.0.0.1:{u.port}{u.path}"))
    return sorted(set(rows), key=lambda r: -len(r[0]))


def location(mount: str, target: str) -> str:
    # Serve semantics: the mount prefix is replaced by the target's path.
    base = urlsplit(target)
    prefix, path = f"http://{base.netloc}", base.path
    if mount.endswith("/"):
        # /files/abc -> <path>abc, where <path> is "/files/" or empty ("/abc")
        head, rx, empty = (path or "/"), f"^{re.escape(mount)}(.*)$", ""
    else:
        # /troubleshoot/x -> <path>/x ; /wizard-os-home/store-install/_updates -> /_updates ; the bare mount -> <path or />
        head, rx, empty = path, f"^{re.escape(mount)}(/.*)?$", ("" if path else "/")
    return (f"location ~ {rx} {{\n"
            f"  set $wz_rest $1;\n"
            f"  if ($wz_rest = \"\") {{ set $wz_rest \"{empty}\"; }}\n"
            f"  proxy_pass {prefix}{head}$wz_rest$is_args$args;\n"
            f"  include /opt/wizard/local-proxy-owner.inc;\n"
            f"  proxy_set_header Origin $wz_serve_origin;\n"
            f"}}\n")


def write(name: str, text: str) -> bool:
    OUT.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(OUT, 0o700)   # also holds the Mac window's root-only socket
    p = OUT / name
    if p.exists() and p.read_text() == text:
        return False
    tmp = p.with_suffix(".tmp")
    tmp.write_text(text)
    os.replace(tmp, p)
    return True


def main() -> int:
    status = tailscale_json("status")
    login = owner_login(status)
    port = shell_port()
    serve = tailscale_json("serve", "status") if login else {}
    rows = handlers(serve, port)
    origin = served_origin(serve, port)
    routes = "# generated by wizard-local-routes from Tailscale Serve; do not edit\n" + \
        "".join(location(m, t) for m, t in rows)
    owner = "# generated by wizard-local-routes; do not edit\n" + \
        (f"proxy_set_header Tailscale-User-Login \"{login}\";\n" if login else
         "proxy_set_header Tailscale-User-Login \"\";\n")
    shell = (f"# generated by wizard-local-routes; do not edit\nset $wz_shell http://127.0.0.1:{port};\n"
             f"set $wz_served_origin \"{origin}\";\n")
    changed = [write("routes.conf", routes), write("owner.conf", owner), write("shell.conf", shell)]
    if any(changed):
        print("changed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
