[Unit]
Description=Wizard onboarding and front door
After=wizard-firstboot.service
Requires=wizard-firstboot.service

[Service]
StandardOutput=journal+console
StandardError=journal+console
User=wizard
Group=wizard
WorkingDirectory=/home/wizard
Environment=HOME=/home/wizard
ExecStart=/opt/wizard/bin/wizard-setup-start
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
