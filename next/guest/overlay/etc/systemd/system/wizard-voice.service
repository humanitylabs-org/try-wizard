[Unit]
Description=Wizard voice: install the transcriber in the background after first launch
ConditionKernelCommandLine=!wizard.provision=1
ConditionPathExists=/var/lib/wizard/provisioned
ConditionPathExists=!/var/lib/wizard/voice-installed
Wants=network-online.target docker.service
After=network-online.target docker.service wizard-firstboot.service

[Service]
Type=simple
User=wizard
Group=wizard
Environment=HOME=/home/wizard
ExecStart=/opt/wizard/bin/wizard-apps fetch-voice
ExecStopPost=/bin/sh -c 'grep -q "\"ready\"" /var/lib/wizard/voice.json 2>/dev/null && touch /var/lib/wizard/voice-installed || true'
Restart=on-failure
RestartSec=30
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
