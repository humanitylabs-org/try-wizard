#!/usr/bin/env python3
"""Bring your Hermes into Wizard: back up the Hermes on this Mac with its own `hermes backup`, then hand the backup to
Wizard OS, which makes it the agent inside Wizard (memory, skills, chats, settings and sign-ins).

    wizard-bring-hermes [--hermes PATH] [--hermes-home DIR] [--port 48031]
    wizard-bring-hermes --undo [--port 48031]

Your Hermes on this Mac is not changed and keeps running; it stays as your copy to go back to. In Wizard, its
messaging (Telegram, Slack, ...) starts switched off and its scheduled jobs start paused, so the two copies never
answer the same chat or run the same job twice. Prints one JSON line.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
from pathlib import Path


def find_hermes(arg: str | None) -> str:
    for c in (arg, shutil.which("hermes"), str(Path.home() / ".local/bin/hermes"), "/opt/homebrew/bin/hermes",
              "/usr/local/bin/hermes"):
        if c and os.access(c, os.X_OK):
            return c
    raise SystemExit(json.dumps({"ok": False, "error": "no_hermes", "detail": "Couldn't find Hermes on this Mac"}))


def talk(port: int, header: str, body: Path | None) -> dict:
    with socket.create_connection(("127.0.0.1", port), timeout=30) as s:
        s.settimeout(3600)
        s.sendall(header.encode() + b"\n")
        if body:
            with body.open("rb") as f:
                while chunk := f.read(1 << 20):
                    s.sendall(chunk)
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    line = buf.split(b"\n")[0].decode(errors="replace")
    try:
        return json.loads(line)
    except ValueError:
        return {"ok": False, "error": "no_reply", "detail": line[-300:] or "Wizard OS closed the connection"}


def main() -> int:
    ap = argparse.ArgumentParser(prog="wizard-bring-hermes", description=__doc__.split("\n\n")[0])
    ap.add_argument("--hermes")
    ap.add_argument("--hermes-home")
    ap.add_argument("--port", type=int, default=int(os.environ.get("WIZARD_IMPORT_PORT") or 48031))
    ap.add_argument("--undo", action="store_true", help="put back the agent Wizard had before the last import")
    ns = ap.parse_args()
    if ns.undo:
        res = talk(ns.port, "undo", None)
        print(json.dumps(res)); return 0 if res.get("ok") else 1
    hermes = find_hermes(ns.hermes)
    env = dict(os.environ)
    if ns.hermes_home:
        env["HERMES_HOME"] = ns.hermes_home
    with tempfile.TemporaryDirectory(prefix="wizard-bring-hermes-") as d:
        os.chmod(d, 0o700)
        zp = Path(d) / "hermes-backup.zip"
        p = subprocess.run([hermes, "backup", "-o", str(zp)], env=env, capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=3600)
        if p.returncode or not zp.is_file():
            print(json.dumps({"ok": False, "error": "backup_failed", "detail": (p.stderr or p.stdout)[-400:]}))
            return 1
        os.chmod(zp, 0o600)
        size = zp.stat().st_size
        try:
            res = talk(ns.port, f"hermes-backup {size}", zp)
        except OSError as e:
            res = {"ok": False, "error": "wizard_not_running", "detail": f"Wizard OS isn't answering ({e})"}
        res["backup_bytes"] = size
    print(json.dumps(res))
    return 0 if res.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
