import Foundation
// Extracted chooseRemote uses NSRect(x:y:width:height:). Foundation alone
// exposes the C geometry type, but not CoreGraphics' Swift initializer.
import CoreGraphics

// Access-detection spy: shadows Foundation.FileManager for the extracted production code, so ANY
// create/stat/exists/list of a path is recorded. Real calls still run (against disposable fixture dirs).
final class FileManager {
    static let `default` = FileManager()
    var touched: [String] = []
    private var real: Foundation.FileManager { Foundation.FileManager.default }
    func createDirectory(at url: URL, withIntermediateDirectories flag: Bool) throws {
        touched.append(url.path); try real.createDirectory(at: url, withIntermediateDirectories: flag)
    }
    func fileExists(atPath path: String) -> Bool { touched.append(path); return real.fileExists(atPath: path) }
    var homeDirectoryForCurrentUser: URL { real.homeDirectoryForCurrentUser }
    func contentsOfDirectory(atPath path: String) throws -> [String] { touched.append(path); return try real.contentsOfDirectory(atPath: path) }
    func attributesOfItem(atPath path: String) throws -> [Foundation.FileAttributeKey: Any] { touched.append(path); return try real.attributesOfItem(atPath: path) }
}

enum Response { case alertFirstButtonReturn, cancel, OK }
final class NSAlert {
    static var response: Response = .cancel
    var messageText = "", informativeText = ""
    var accessoryView: Any?
    let window = FakeWindow()
    func addButton(withTitle: String) {}
    func runModal() -> Response { Self.response }
}
final class FakeWindow { var initialFirstResponder: Any? }
final class NSTextField {
    static var text = "https://remote.test"
    var stringValue: String { Self.text }
    var placeholderString = ""
    init(frame: CGRect) {}
}
final class NSOpenPanel {
    static var response: Response = .cancel
    static var selected: URL?
    var url: URL? { Self.selected }
    var message = "", canChooseDirectories = false, canChooseFiles = false, canCreateDirectories = false
    var directoryURL: URL?
    func runModal() -> Response { Self.response }
}
enum Kind { case thisMac, remote }
struct Backend: Equatable { var kind: Kind; var name: String; var url: String }
final class Defaults {
    var confirmed = false
    func bool(forKey: String) -> Bool { confirmed }
    func set(_ value: Bool, forKey: String) { confirmed = value }
    func removeObject(forKey: String) { confirmed = false }
}
enum Store {
    static var backends: [Backend] = []
    static var activeIndex = 0
    static var active: Backend? { backends.indices.contains(activeIndex) ? backends[activeIndex] : backends.first }
    static let d = Defaults()
}
enum WizardShared {
    static var root = URL(fileURLWithPath: CommandLine.arguments[1])
    static var osInstalled = true
    static var share: URL?
    static var shareReads = 0, writes = 0, defaultReads = 0
    static let filesShareTag = "wizard-files"
    static let localSetupURL = URL(string: "http://127.0.0.1:48030/")!
    static var defaultFilesFolder: URL { defaultReads += 1; return root.appendingPathComponent("Documents/Wizard MVP") }
    static var usePersisted = false
    static var filesFolder: URL? { shareReads += 1; return usePersisted ? PersistedShare.filesFolder : share }
    // PRODUCTION_ACTIVE_MOCK
    static func setFilesFolder(_ url: URL) throws { writes += 1; share = url }
}
enum HostControl {
    static var maintenanceInProgress = false
    static var isRunning = true, hasForeignRunner = false
    static var commands: [String] = []
    static func send(_ cmd: String) { commands.append(cmd) }
}
final class WizardUpdater { static let shared = WizardUpdater(); var hasPendingWork = false; func admitLegacyBootstrap() -> Bool { false } }
final class FakeInstaller { var isBusy = false; func fetchSizeNote(_ done: (String?) -> Void) { done(nil) } }
final class Overlay { var isHidden = false }
final class Title { var stringValue = "" }
final class Web { func stopLoading() {}; func loadHTMLString(_ text: String, baseURL: URL?) {} }
final class GateController {
    var allowed = true, deferred = false
    var callback: ((Bool) -> Void)?
    let installer = FakeInstaller()
    func admitUpdateRestart(_ done: @escaping (Bool) -> Void) {
        if deferred { callback = done } else { done(allowed) }
    }
}
final class Busy { var isBusy = false, busy = false }
final class MeetingRecorder { static let shared = MeetingRecorder(); var isRecording = false }
final class VoiceKeys { static let shared = VoiceKeys(); var state: [String: Any] = ["mode": "idle"] }
final class AppDelegate {
    let controller = GateController()
    var backup: Busy?, removal: Busy?
    var allowed: Bool { get { controller.allowed } set { controller.allowed = newValue } }
    var deferred: Bool { get { controller.deferred } set { controller.deferred = newValue } }
    var callback: ((Bool) -> Void)? { controller.callback }
    func rebuildWizardMenu() {}
    // PRODUCTION_ADMISSION
}
final class Application { var delegate: Any? = AppDelegate() }
let NSApp = Application()
final class Controller: NSObject {
    var route = "", homeURL: URL?, resolvedOrigins: Set<String> = []
    let installer = FakeInstaller(), overlay = Overlay()
    let title = Title(), web = Web()
    var frozen = false
    func clearLocalVoice() {}
    func connectLocal() { route = "local" }
    func installOnThisMac() { route = "install" }
    func showOverlay(_ title: String, _ message: String, spinning: Bool = true, actions: [(String, Selector)] = []) { route = title; self.title.stringValue = title }
    func resolveHome(_ url: URL, done: (URL) -> Void) { done(url) }
    func load(_ url: URL) { route = "remote" }
    func loadHome() { route = "home" }
    func setUpdateFrozen(_ value: Bool) { frozen = value }
    @objc func useDefaultFilesFolder() { setFilesFolder(WizardShared.defaultFilesFolder) }
    // PRODUCTION_METHODS
}
let local = Backend(kind: .thisMac, name: "This Mac", url: WizardShared.localSetupURL.absoluteString)
let remote = Backend(kind: .remote, name: "Remote", url: "https://remote.test")
var failures = 0, checks = 0
func check(_ name: String, _ ok: Bool) {
    checks += 1
    if ok { print("PASS \(name)") } else { failures += 1; print("FAIL \(name)") }
}
func reset(_ backend: Backend? = local, installed: Bool = true, share: URL? = nil) -> Controller {
    Store.backends = backend.map { [$0] } ?? []; Store.activeIndex = 0; Store.d.confirmed = false
    WizardShared.osInstalled = installed; WizardShared.share = share
    WizardShared.shareReads = 0; WizardShared.defaultReads = 0; WizardShared.writes = 0
    HostControl.commands = []; HostControl.maintenanceInProgress = false
    HostControl.isRunning = true; HostControl.hasForeignRunner = false
    MeetingRecorder.shared.isRecording = false; VoiceKeys.shared.state = ["mode": "idle"]
    WizardUpdater.shared.hasPendingWork = false
    NSAlert.response = .cancel; NSOpenPanel.response = .cancel
    NSApp.delegate = AppDelegate()
    return Controller()
}
var c = reset(nil, installed: false); c.begin()
check("fresh-hosting-first", c.route == "Where should Wizard live?" && WizardShared.defaultReads == 0 && WizardShared.shareReads == 0)
c = reset(); c.begin()
check("local-no-share", c.route == "local" && WizardShared.defaultReads == 0 && WizardShared.shareReads == 0 && WizardShared.writes == 0)
c = reset(remote); c.begin()
check("retained-remote", c.route == "remote" && WizardShared.shareReads == 0)
let saved = WizardShared.root.appendingPathComponent("saved-share", isDirectory: true)
try FileManager.default.createDirectory(at: saved, withIntermediateDirectories: true)
let sentinel = saved.appendingPathComponent("keep.txt"); try "keep".write(to: sentinel, atomically: true, encoding: .utf8)
c = reset(local, share: saved); c.begin()
let preservedAfterResume = try String(contentsOf: sentinel)
check("saved-share-compatibility", c.route == "local" && WizardShared.share == saved && WizardShared.writes == 0 && preservedAfterResume == "keep")
c = reset(local, installed: false, share: saved); c.begin()
check("abandoned-local", c.route == "Where should Wizard live?" && WizardShared.writes == 0)
c = reset(nil, installed: false); c.chooseThisMac()
check("explicit-local-before-install", c.route == "install" && Store.d.confirmed && WizardShared.shareReads == 0)
c = reset(nil, installed: false); c.chooseRemote()
check("remote-cancel-before-commit", Store.backends.isEmpty && HostControl.commands.isEmpty)
c = reset(nil, installed: false); NSAlert.response = .alertFirstButtonReturn; c.chooseRemote()
check("explicit-remote", Store.active?.kind == .remote && c.route == "remote" && WizardShared.shareReads == 0)
c = reset(nil, installed: false); c.backToChooser()
check("back-before-commit", Store.backends.isEmpty && c.route == "Where should Wizard live?" && WizardShared.writes == 0)
c = reset(local, share: saved); Store.d.confirmed = true; c.startFreshOnboarding()
let preservedAfterFreshRoute = try String(contentsOf: sentinel)
check("start-fresh", Store.backends.isEmpty && !Store.d.confirmed && c.route == "Where should Wizard live?" && WizardShared.share == saved && preservedAfterFreshRoute == "keep")
let chosen = WizardShared.root.appendingPathComponent("explicit-share")
c = reset(); c.setFilesFolder(chosen)
check("first-explicit-share-cancel", WizardShared.writes == 0 && HostControl.commands.isEmpty)
c = reset(); NSAlert.response = .alertFirstButtonReturn
(NSApp.delegate as! AppDelegate).allowed = false; c.setFilesFolder(chosen)
check("busy-share-no-commit", WizardShared.writes == 0 && HostControl.commands.isEmpty)
c = reset(); NSAlert.response = .alertFirstButtonReturn; c.setFilesFolder(chosen)
check("first-explicit-share", WizardShared.share == chosen && WizardShared.writes == 1 && HostControl.commands == ["restart"])
c = reset(); NSAlert.response = .alertFirstButtonReturn
let delegate = NSApp.delegate as! AppDelegate; delegate.deferred = true
c.setFilesFolder(chosen); Store.backends = [remote]; delegate.callback?(true)
check("stale-share-callback", WizardShared.writes == 0 && HostControl.commands.isEmpty)
c = reset(); NSAlert.response = .alertFirstButtonReturn
let busyDelegate = NSApp.delegate as! AppDelegate; busyDelegate.deferred = true
c.setFilesFolder(chosen); MeetingRecorder.shared.isRecording = true; busyDelegate.callback?(true)
check("native-busy-during-admission", WizardShared.writes == 0 && HostControl.commands.isEmpty)
c = reset(); c.chooseFilesFolder()
check("picker-cancel-preserves-share", WizardShared.writes == 0 && HostControl.commands.isEmpty)
// Exercise the actual production persistence against a disposable directory,
// with no UserDefaults or owner-home access.
enum PersistedShare {
    static var supportDir: URL { WizardShared.root.appendingPathComponent("support") }
    static var filesFolderFile: URL { supportDir.appendingPathComponent("files-folder.json") }
    // Path accessor spy: the legacy default is only ever computed as a string (no disk access).
    static var defaultFilesFolderReads = 0
    static var defaultFilesFolder: URL { defaultFilesFolderReads += 1; return legacyDefault }
    static var legacyDefault: URL { WizardShared.root.appendingPathComponent("Documents/Wizard MVP", isDirectory: true) }
    // PRODUCTION_PERSISTENCE
}
check("persisted-unset-is-supported", PersistedShare.filesFolder == nil)
try PersistedShare.setFilesFolder(saved)
check("persisted-exact-selection", PersistedShare.filesFolder == saved)
let priorBytes = try Data(contentsOf: PersistedShare.filesFolderFile)
_ = PersistedShare.filesFolder
check("persisted-read-does-not-migrate", try Data(contentsOf: PersistedShare.filesFolderFile) == priorBytes)

var sharedDirectoryInits: [URL] = []
final class VZSharedDirectory { let url: URL; let readOnly: Bool; init(url: URL, readOnly: Bool) { self.url = url; self.readOnly = readOnly; sharedDirectoryInits.append(url) } }
final class VZSingleDirectoryShare { let directory: VZSharedDirectory; init(directory: VZSharedDirectory) { self.directory = directory } }
final class VZVirtioFileSystemDeviceConfiguration { let tag: String; var share: VZSingleDirectoryShare?; init(tag: String) { self.tag = tag } }
final class Configuration { var directorySharingDevices: [VZVirtioFileSystemDeviceConfiguration] = [] }
typealias VZVirtualMachineConfiguration = Configuration
var hostLog: [String] = []
func log(_ text: String) { hostLog.append(text) }
// PRODUCTION_HOST_SHARE
func shareConfiguration() -> Configuration {
    let c = Configuration()
    addFilesShare(to: c)
    return c
}
WizardShared.share = nil
check("host-nil-share-no-device", shareConfiguration().directorySharingDevices.isEmpty)
WizardShared.share = saved
let device = shareConfiguration().directorySharingDevices.first
check("host-saved-share-exact-subtree", device?.tag == "wizard-files" && device?.share?.directory.url == saved && device?.share?.directory.readOnly == false)
let finalSentinel = try String(contentsOf: sentinel)
check("shared-files-never-moved-or-deleted", finalSentinel == "keep")

// ---- Upgrade from the PRIOR build's persisted state (build 312) ----------------------------------------
// The old build auto-saved ~/Documents/Wizard MVP into files-folder.json at startup (no consent marker).
// These checks seed that file with the old build's own writer and drive the real Host boot decision.
enum LegacyD22 {
    static var supportDir: URL { PersistedShare.supportDir }
    static var filesFolderFile: URL { PersistedShare.filesFolderFile }
    // PRODUCTION_LEGACY_WRITER
}
func freshSupport() throws {
    try? Foundation.FileManager.default.removeItem(at: PersistedShare.supportDir)
    try Foundation.FileManager.default.createDirectory(at: PersistedShare.supportDir, withIntermediateDirectories: true)
}
func seedLegacyAutoShare(_ url: URL) throws -> Data {
    try freshSupport(); try LegacyD22.setFilesFolder(url)
    return try Data(contentsOf: PersistedShare.filesFolderFile)
}
func resetSpies() {
    FileManager.default.touched = []; sharedDirectoryInits = []; hostLog = []
    PersistedShare.defaultFilesFolderReads = 0; WizardShared.usePersisted = true
}
func touchedUnder(_ folder: URL) -> [String] {
    let prefix = folder.path.lowercased(), documents = folder.deletingLastPathComponent().path.lowercased()
    return FileManager.default.touched.filter { let p = $0.lowercased(); return p == prefix || p.hasPrefix(prefix + "/") || p == documents || p.hasPrefix(documents + "/") }
}
func exists(_ url: URL) -> Bool { Foundation.FileManager.default.fileExists(atPath: url.path) }
let legacyDefault = PersistedShare.legacyDefault
let escapedLegacy = legacyDefault.path.replacingOccurrences(of: "/", with: "\\/")

// The seed must be byte-for-byte what the old build wrote: pretty JSON, escaped slashes, NO marker.
let seedBytes = try seedLegacyAutoShare(legacyDefault)
check("legacy_seed_is_exactly_what_the_old_build_wrote", String(data: seedBytes, encoding: .utf8) == "{\n  \"path\" : \"\(escapedLegacy)\"\n}")

do {
    precondition(!exists(legacyDefault) && !exists(legacyDefault.deletingLastPathComponent()))
    let before = try seedLegacyAutoShare(legacyDefault); resetSpies()
    let configuration = shareConfiguration()
    let touched = touchedUnder(legacyDefault)
    let after = try Data(contentsOf: PersistedShare.filesFolderFile)
    if !touched.isEmpty { print("DETAIL touched: \(touched)") }
    if !sharedDirectoryInits.isEmpty { print("DETAIL VZSharedDirectory: \(sharedDirectoryInits.map { $0.path })") }
    if exists(legacyDefault.deletingLastPathComponent()) { print("DETAIL Documents-like parent was created") }
    check("test_upgrade_with_legacy_default_share_does_not_touch_documents",
          configuration.directorySharingDevices.isEmpty && sharedDirectoryInits.isEmpty && touched.isEmpty
          && !exists(legacyDefault) && !exists(legacyDefault.deletingLastPathComponent()))
    check("test_legacy_share_file_is_never_rewritten_by_boot", before == after)
    try? Foundation.FileManager.default.removeItem(at: legacyDefault.deletingLastPathComponent())
}
do {
    // Same decision when the legacy folder really exists with the owner's files: still not opened or listed.
    let before = try seedLegacyAutoShare(legacyDefault)
    try Foundation.FileManager.default.createDirectory(at: legacyDefault, withIntermediateDirectories: true)
    let owner = legacyDefault.appendingPathComponent("owner-file.txt"); try "mine".write(to: owner, atomically: true, encoding: .utf8)
    resetSpies(); let configuration = shareConfiguration()
    let ownerText = try String(contentsOf: owner, encoding: .utf8), savedAfter = try Data(contentsOf: PersistedShare.filesFolderFile)
    check("test_existing_legacy_folder_is_not_mounted_or_opened_but_left_intact",
          configuration.directorySharingDevices.isEmpty && sharedDirectoryInits.isEmpty && touchedUnder(legacyDefault).isEmpty
          && ownerText == "mine" && savedAfter == before)
    try Foundation.FileManager.default.removeItem(at: legacyDefault.deletingLastPathComponent())
}
do {
    // Spelling variants of the legacy default are still the same legacy default (string compare only).
    var ok = true
    for variant in [legacyDefault.path + "/", WizardShared.root.path + "/Documents/./Wizard MVP", WizardShared.root.path + "/Documents/x/../Wizard MVP",
                    WizardShared.root.path + "/documents/wizard mvp", WizardShared.root.path + "//Documents//Wizard MVP"] {
        try freshSupport()
        let data = try JSONSerialization.data(withJSONObject: ["path": variant], options: [.prettyPrinted])
        try data.write(to: PersistedShare.filesFolderFile)
        resetSpies(); let configuration = shareConfiguration()
        if !(configuration.directorySharingDevices.isEmpty && sharedDirectoryInits.isEmpty && touchedUnder(legacyDefault).isEmpty) { ok = false; print("DETAIL variant mounted/touched: \(variant)") }
        if exists(legacyDefault.deletingLastPathComponent()) { ok = false; print("DETAIL variant created Documents: \(variant)") }
        try? Foundation.FileManager.default.removeItem(at: legacyDefault.deletingLastPathComponent())
    }
    check("test_legacy_default_spelling_variants_are_not_touched", ok)
}
do {
    let other = WizardShared.root.appendingPathComponent("Elsewhere/My Files", isDirectory: true)
    try Foundation.FileManager.default.createDirectory(at: other, withIntermediateDirectories: true)
    _ = try seedLegacyAutoShare(other); resetSpies()
    let device = shareConfiguration().directorySharingDevices.first
    check("test_other_path_legacy_share_is_honored",
          device?.tag == "wizard-files" && device?.share?.directory.url == other && device?.share?.directory.readOnly == false && touchedUnder(legacyDefault).isEmpty)
}
do {
    let chosen = WizardShared.root.appendingPathComponent("Chosen Folder", isDirectory: true)
    try freshSupport(); try PersistedShare.setFilesFolder(chosen)
    let written = try String(contentsOf: PersistedShare.filesFolderFile, encoding: .utf8)
    check("test_explicit_share_carries_explicit_marker", written.contains("\"explicit\" : true"))
    resetSpies()   // "relaunch": a new boot decision from the saved file alone
    let device = shareConfiguration().directorySharingDevices.first
    check("test_explicit_share_is_honored_on_relaunch", device?.share?.directory.url == chosen && device?.tag == "wizard-files")
    try freshSupport(); try PersistedShare.setFilesFolder(legacyDefault)
    resetSpies()
    let explicitAtDefault = shareConfiguration().directorySharingDevices.first
    check("test_explicit_share_at_legacy_default_path_is_honored", explicitAtDefault?.share?.directory.url == legacyDefault)
    try? Foundation.FileManager.default.removeItem(at: legacyDefault.deletingLastPathComponent())
}
do {
    // Detector proof: the pre-312 boot rule applied to the same seed MUST be caught by the spy.
    _ = try seedLegacyAutoShare(legacyDefault); resetSpies()
    let c = Configuration()
    if let folder = PersistedShare.filesFolder {
        try? FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
        c.directorySharingDevices = [VZVirtioFileSystemDeviceConfiguration(tag: "x")]
        _ = VZSharedDirectory(url: folder, readOnly: false)
    }
    check("test_access_detector_catches_a_legacy_folder_create_and_mount",
          !touchedUnder(legacyDefault).isEmpty && !sharedDirectoryInits.isEmpty && exists(legacyDefault))
    try? Foundation.FileManager.default.removeItem(at: legacyDefault.deletingLastPathComponent())
}
// PRODUCTION_ACTIVE_CHECKS
WizardShared.usePersisted = false
print("RESULT \(checks) checks; \(failures) failed. Mocked UI/Host; no real TCC/VM.")
exit(failures == 0 ? 0 : 1)
