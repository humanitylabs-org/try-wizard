#!/usr/bin/env python3
"""Developer-only TCP relay: expose loopback Wizard services on the guest NIC so the
Mac's QEMU port forwards can reach them. Exits immediately unless the Mac owner
enabled SSH forwarding for this boot (tryomarchy.ssh_access=1)."""
import asyncio
import sys
from pathlib import Path

PORTS = {18923: 8923, 18865: 8865}


def dev_mode() -> bool:
    try:
        return "tryomarchy.ssh_access=1" in Path("/proc/cmdline").read_text().split()
    except OSError:
        return False


async def pipe(reader, writer):
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
    except Exception:
        pass
    finally:
        writer.close()


def handler(target_port):
    async def handle(reader, writer):
        try:
            up_reader, up_writer = await asyncio.open_connection("127.0.0.1", target_port)
        except OSError:
            writer.close()
            return
        await asyncio.gather(pipe(reader, up_writer), pipe(up_reader, writer))
    return handle


async def main():
    servers = [await asyncio.start_server(handler(dst), "0.0.0.0", src) for src, dst in PORTS.items()]
    await asyncio.gather(*(s.serve_forever() for s in servers))


if __name__ == "__main__":
    if not dev_mode():
        sys.exit(0)
    asyncio.run(main())
