#!/bin/bash
# Per-install secrets and ownership. Idempotent; runs before every Wizard service.
set -euo pipefail
install -d -o wizard -g wizard -m 0750 /var/lib/wizard /var/lib/wizard/hermes /var/lib/wizard/ux
if [[ ! -s /var/lib/wizard/secrets.env ]]; then
  key=$(head -c 32 /dev/urandom | base64 | tr -d '=+/\n' | head -c 43)
  umask 077
  printf 'WIZARD_HERMES_API_KEY=%s\nAPI_SERVER_KEY=%s\n' "$key" "$key" >/var/lib/wizard/secrets.env
fi
chown wizard:wizard /var/lib/wizard/secrets.env
chmod 0600 /var/lib/wizard/secrets.env
# Hermes, the UX server, and onboarding all run as the wizard user.
chown -R wizard:wizard /var/lib/wizard
