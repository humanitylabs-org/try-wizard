    fi
    qemu_netdev=$QEMU_PORT_FORWARDING_NETDEV
    port_forwarding_summary=$QEMU_PORT_FORWARDING_SUMMARY
    ssh_kernel_argument=''
    if ((QEMU_PORT_FORWARDING_ENABLES_SSH)); then
